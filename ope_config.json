{
    "input_femto_bolt": {
        "type": "dir",  
        "name": "00001.jpg",
        "cam_type": "femto_bolt",
        "K_filename": "intrinsics_ds.txt"
    },
    "input_zed_m": {
        "type": "dir",  
        "name": "00001.jpg",
        "cam_type": "zed_m",
        "K_filename": "calibration.json"
    },
    "objects": [["can_mtdew", 0.995], ["can_fanta", 0.995], ["drill_yellow", 1.012], ["usb_4", 1.0]]
    ,
    "object": 0
    ,
    "detector": {
        "name": "yolo",
        "weights": "weights/best.pt",
        "options": {
            "conf_thr": 0.25
        }
    },
    "segmentator": {
        "name": "sam2",
        "weights": "weights/sam2.1_hiera_tiny.pt",
        "options": {
            "repo": "sam2_repo",
            "config": "configs/sam2.1/sam2.1_hiera_t.yaml"
        }
        
    },
    "feat_extractor": {
        "name": "DINOv2",
        "options": {
            "model": "dinov2_vits14",
            "input_size": 224,
            "onnx": "weights/dino_vits14_224.onnx",
            "trt_cache_dir": "weights/trt_cache",
            "warmup": true,
            "warmup_runs": 1,
            "require_gpu": true
        }

    },
    "matcher": {
        "name": "EDM_TRT",
        "onnx": "weights/edm_outdoor_w672_h672_topk2469.onnx",
        "trt_cache_dir": "weights/trt_cache",
        "options": {
            "conf_thr": 0.35,
            "input_size": 672,
            "warmup": true,
            "warmup_runs": 1,
            "require_gpu": true
        }
    },
    "pnp": {
        "reproj_thr": 4.0
    },
    "renderer": {
        "name": "3dgs",
        "options": {            
            "width": 1920,
            "height": 1080,
            "background": [0,0,0],
            "sh_degree": 3,            
            "iters": 40,                
            "lr_rot": 2e-3,
            "lr_trans": 3e-3,
            "warmup_steps": 5,
            "early_stop_steps": 20,
            "early_stop_thr": 1e-5
        },
        "iterations": [[100, 10], [50, 5], [40, 5], [30, 4], [20, 3]]
    },
    "comments": [
        "input - type: [file, dir, cam]",   
        "               file: a single image file",
        "               dir: image files in dir",
        "               cam: image from a cam",
        {
            "name": "LoFTR",
            "options": {
                "pretrained": "outdoor",
                "conf_thr": 0.5,
                "input_size": 840
            }
        }
    ]
}

