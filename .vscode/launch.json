{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {   "name": "Object pose estimation",
            "type": "debugpy",
            "request": "launch",
            "program": "estimate_object_pose.py",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--config", "ope_config.json"
            ]
        },
        {
            "name": "Evaluate pose against GT",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/evaluate_pose_gt.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--gt", "data/output/can_mtdew/result_gt/refined_poses.json",        // 자세 추정 GT 결과 경로
                "--estimate", "data/output/can_mtdew/result/refined_poses.json",     // 자세 추정 결과 경로
                "--gt-camera", "zed2i_1_L",                                          // 기준 카메라, 현재는 2개의 zed2i 카메라 중 zed2i_1_L로 설정
                "--estimate-camera", "femto_color",                                  // 기준 카메라를 제외한 자세 추정 메인 카메라
                "--calibration", "data/camera_calibration.json",                     // 카메라 간 calibration 결과, 기준 카메라와 자세 추정 카메라 간 관계 추출
                "--calibration-translation-unit", "cm",
                "--model-ply", "data/object/can_mtdew/model/point_cloud.ply",
                "--model-unit", "m",
                "--output-dir", "data/output/can_mtdew/evaluation/zed2i_1_R"
            ]
        },
        {   "name": "Step 1: Object detection & segmentation from query image",
            "type": "debugpy",
            "request": "launch",
            "module": "modules_6d.step1_query_extraction",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--out_dir", "data/output/can_mtdew",
                "--query_img", "data/object/can_mtdew/query/00006.jpg",
                "--yolo_weights", "weights/best_3cls_v2.pt",
                "--sam2_checkpoint", "weights/sam2.1_hiera_tiny.pt",
                "--sam2_repo", "sam2_repo",
                "--sam2_config", "configs/sam2.1/sam2.1_hiera_t.yaml",
                "--device", "cuda",
                "--yolo_conf", "0.25",
                "--bbox_margin", "10",
                "--use_manual_fallback"
            ]
        },
        {   "name": "Generate gallery poses",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/generate_gallery_poses.py",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--out_dir", "data",
                "--subdivisions", "2",
                "--radius", "0.5,0.6,0.7,0.8",
                "--roll_scheme", "level2_close_rolls",
                "--min_elevation_deg", "-90",
                "--max_elevation_deg", "90",
                "--preview_size", "900"
            ]
        },
        {   "name": "Step 4: Rendering gallery",
            "type": "debugpy",
            "request": "launch",
            "program": "render_gallery.py",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--out_dir", "data/output/can_mtdew",
                "--model_dir", "data/object/can_mtdew/model",
                "--gallery_pose_json", "data/gallery_poses.json",
                "--intrinsics_path", "data/camera/femto_bolt/intrinsics_ds.txt",
                "--width", "1920",
                "--height", "1080",
                "--background", "0,0,0",                // black; for pink use "--background", "255,0,255"
                "--sh_degree", "3",
                "--gs_mode", "3dgs",
                "--dino_model", "dinov2_vits14",
                "--dino_input_size", "224",
                "--save_depth",
                "--save_xyz",              
            ]
        },
        {   "name": "Step 5: Retrieve gallery & Feature Matching",
            "type": "debugpy",
            "request": "launch",
            "program": "main_6d.py",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--stage", "step5",
                "--query_img", "data/object/can_mtdew/query/00006.jpg",
                "--out_dir", "data/output/can_mtdew",
                "--sim_method", "dino_loftr",
                "--dino_model", "dinov2_vits14",
                "--dino_input_size", "224",
                "--topk", "3",
                "--crop_margin", "12",
                "--nonblack_thresh", "8",
                "--device", "cuda",                
                "--loftr_pretrained", "outdoor",
                "--loftr_conf_thresh", "0.5",
                "--loftr_ransac_thresh", "200.0"
            ]
        },
        {   "name": "Step 6: PnP",
            "type": "debugpy",
            "request": "launch",
            "program": "main_6d.py",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--stage", "step6",                
                "--gs_model_dir", "data/object/can_mtdew/model",
                "--out_dir", "data/output/can_mtdew",
                "--gs_mode", "3dgs",
                "--gallery_pose_json", "data/gallery_poses.json",
                "--intrinsics_path", "data/camera/femto_bolt/intrinsics_ds.txt",
                "--query_img", "data/object/can_mtdew/query/00006.jpg",
                "--pnp_reproj_error", "4.0",
                "--render_width", "1920",
                "--render_height", "1080",
                "--bg_color", "0,0,0",
                "--t_refine_iou_thresh", "0.30",
                "--skip_t_refine"
            ]
        },
        {
            "name": "Step 7: Refine with Render & Compare",
            "type": "debugpy",
            "request": "launch",
            "program": "refine_pose.py",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "args": [
                "--gs_model_dir",       "data/object/can_mtdew/model",
                "--out_dir",            "data/output/can_mtdew",
                "--query_img",          "data/object/can_mtdew/query/00006.jpg",
                "--intrinsics_path",    "data/camera/femto_bolt/intrinsics_ds.txt",
                "--width",              "1920",
                "--height",             "1080",
                "--background",         "0,0,0",
                "--sh_degree",          "3",
                "--iters",              "100",
                "--lr_rot",             "1e-2",
                "--lr_trans",           "5e-3",
                "--warmup_steps",       "10",
                "--early_stop_steps",   "20",
                "--early_stop_thresh",  "1e-5",
                "--crop_size",          "320",
                "--crop_margin_scale",  "1.3",
                "--rt_mode"
            ]
        }
    ]
}
